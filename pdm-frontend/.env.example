# Supabase project credentials for the dashboard login.
# VITE_SUPABASE_URL: Integrations -> Data API -> API URL, base only, WITHOUT
#   the trailing /rest/v1/  (e.g. https://<project>.supabase.co)
# VITE_SUPABASE_ANON_KEY: Project Settings -> API Keys -> Legacy anon,
#   service_role API keys -> the "anon" "public" key. Never service_role.
# Copy this file to .env.local and fill both in. Leave them blank (or delete
# the file) to run the dashboard with no login gate.
#
# The anon key is a publishable client key — it is safe in the browser bundle.
# Access is enforced by Row Level Security, not by hiding this value.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
