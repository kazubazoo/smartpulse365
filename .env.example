# ---------------------------------------------------------------------------
# InfluxDB 3 Core
# ---------------------------------------------------------------------------
# Generate after the first `docker compose up -d influxdb`:
#   docker compose exec influxdb influxdb3 create token --admin
INFLUXDB3_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Machine registry (fallback)
# ---------------------------------------------------------------------------
# Used only when Supabase is not configured — otherwise machines are managed on
# the dashboard's Machines page. Format: id:Display Name, comma separated.
MACHINES=motor01:Motor 01

# Rows written before the machine_id tag existed are attributed to this machine.
DEFAULT_MACHINE_ID=motor01

# A machine is "online" while its newest reading is younger than this.
ONLINE_WINDOW_SECONDS=30

# Window the Overview cards count anomalies over.
ANOMALY_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Supabase (optional — enables login, per-user settings, machine registry)
# ---------------------------------------------------------------------------
# Leave blank to run unauthenticated on an isolated plant network.
# Values from Supabase Dashboard -> Project Settings -> API.
# The frontend needs the SAME values in pdm-frontend/.env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Port overrides (optional)
# ---------------------------------------------------------------------------
# Defaults are the conventional ports and are used when these are unset � a
# fresh clone needs none of this. Set one only when the host already has
# something on that port (e.g. a natively-installed Node-RED on 1880, or a
# Windows mosquitto service on 1883).
#
# NODE_RED_PORT=1881
# MQTT_PORT=1884
# MQTT_WS_PORT=9002
# API_PORT=8000
# INFLUXDB_PORT=8181
# INFLUXDB_EXPLORER_PORT=8888
# INFLUXDB_EXPLORER_API_PORT=8889
# GRAFANA_PORT=3000
# POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Telemetry source — the company's InfluxDB 2.x server
# ---------------------------------------------------------------------------
# The dashboard READS from here. Nothing in this repo writes to it: Node-RED
# publishes to the Novaflow MQTT broker and their ingest lands the data in this
# bucket. The local influxdb container is a separate store, still written by the
# flow and read by Grafana.
#
# Token: InfluxDB UI (the server serves its own UI on :8086) ->
#   Load Data -> API Tokens -> Generate. A read-only token scoped to this one
#   bucket is enough, and is what the API should be given.
INFLUX_URL=http://sm365db.novaplus.my:8086
INFLUX_TOKEN=
INFLUX_ORG=Novaflow
INFLUX_BUCKET=PREDICTIVE_MAINTAINANCE_MODULE
# Measurement the ingest writes the readings under.
INFLUX_MEASUREMENT=motor_metrics

# The API refuses to send the token in cleartext to a remote host, so this URL
# must be https:// once the server terminates TLS. http:// is allowed only for a
# local container or loopback. Set this to true to override deliberately.
# INFLUX_ALLOW_INSECURE=false
