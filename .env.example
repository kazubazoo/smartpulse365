# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Only INFLUX_TOKEN is strictly required for the dashboard to show data. Every
# other INFLUX_* value below is also the built-in default in pdm-backend/main.py,
# so leaving one blank uses the production value.

# ---------------------------------------------------------------------------
# Telemetry source — the company's cloud InfluxDB 2.x (REQUIRED)
# ---------------------------------------------------------------------------
# The dashboard READS from here, and only from here. Nothing in this repo writes
# to it: Node-RED publishes to the Novaflow MQTT broker and Novaflow's ingest
# stores the data in this bucket.
#
# Token: open the InfluxDB UI (http://sm365db.novaplus.my:8086), then
# Load Data -> API Tokens -> Generate -> Custom, with read access to this one
# bucket only. Never use an all-access or admin token here.
INFLUX_URL=http://sm365db.novaplus.my:8086
INFLUX_TOKEN=
INFLUX_ORG=Novaflow
INFLUX_BUCKET=PREDICTIVE_MAINTAINANCE_MODULE
# The measurement Novaflow's ingest writes into (the payload's device_type).
INFLUX_MEASUREMENT=MOTOR

# The API refuses to send the token in plain HTTP to a remote host. Until the
# server terminates TLS (so INFLUX_URL can be https://), this must be true for
# the dashboard to show any data. Rotate the token and remove this before any
# deployment beyond a trusted network.
# INFLUX_ALLOW_INSECURE=true

# ---------------------------------------------------------------------------
# Machines
# ---------------------------------------------------------------------------
# Used only when Supabase is not configured — otherwise machines are managed on
# the dashboard's Machines page. Format: id:Display Name, comma separated.
# The id must equal the device_id the PLC publishes (MOTOR001).
MACHINES=MOTOR001:Motor 01

# The machine assumed when a row carries no machine tag. Only matters for a
# store with legacy untagged rows; the cloud bucket tags every row.
DEFAULT_MACHINE_ID=MOTOR001

# A machine is "online" while its newest reading is younger than this.
ONLINE_WINDOW_SECONDS=30

# Window the Overview cards count anomalies over.
ANOMALY_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Supabase (optional — login, per-user settings, machine registry)
# ---------------------------------------------------------------------------
# Leave blank to run with no login on an isolated plant network.
# Values from Supabase Dashboard -> Project Settings -> API.
# The frontend needs the SAME values in pdm-frontend/.env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Local InfluxDB 3 Core (Node-RED's local store, read by Grafana only)
# ---------------------------------------------------------------------------
# NOT used by the dashboard. Generate after the first `docker compose up -d influxdb`:
#   docker compose exec influxdb influxdb3 create token --admin
INFLUXDB3_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Port overrides (optional)
# ---------------------------------------------------------------------------
# Defaults are the conventional ports and are used when these are unset — a
# fresh clone needs none of this. Set one only when the host already has
# something on that port (e.g. a natively-installed Node-RED on 1880, or a
# Windows mosquitto service on 1883).
#
# NODE_RED_PORT=1881
# MQTT_PORT=1884
# MQTT_WS_PORT=9002
# API_PORT=8000
# INFLUXDB_PORT=8181
# INFLUXDB_EXPLORER_PORT=8888
# INFLUXDB_EXPLORER_API_PORT=8889
# GRAFANA_PORT=3000
# POSTGRES_PORT=5432
